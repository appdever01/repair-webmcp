{
  "name": "repair-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=2",
    "test:domain": "vitest run tests/domain --maxWorkers=2",
    "test:webmcp": "vitest run tests/webmcp --maxWorkers=2",
    "test:ui": "vitest run tests/ui --maxWorkers=2",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "test:e2e": "playwright test --workers=2",
    "check": "biome check .",
    "format": "biome format --write .",
    "schema": "node scripts/generate-schema.ts",
    "budget": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@iconjar/icons": "file:vendor/iconjar-stroke-standard-4.3.0-iconjar.2.tgz",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "webmcp-types": "0.1.5"
  },
  "packageManager": "pnpm@11.7.0"
}
