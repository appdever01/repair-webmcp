  "hypotheses": [
    {
      "id": "battery.high.resistance",
      "label": "Battery cell wear",
      "componentIds": ["battery.pack"],
      "initialWeight": 35,
      "evidenceFor": [
        "Very short runtime",
        "Voltage collapse under load",
        "Voltage rebound after load"
      ],
      "evidenceAgainst": ["Stable voltage under load"]
    },
    {
      "id": "charge.controller.failure",
      "label": "Charge controller fault",
      "componentIds": ["charge.board", "solar.panel", "usb.port"],
      "initialWeight": 35,
      "evidenceFor": ["Missing charge voltage", "No charge indicator"],
      "evidenceAgainst": ["Normal charge indicator", "Battery reaches nominal range"]
    },
    {
      "id": "led.board.overdraw",
      "label": "LED board overdraw",
      "componentIds": ["led.array"],
      "initialWeight": 30,
      "evidenceFor": ["Unusual LED heat", "Battery stays stable off-load"],
      "evidenceAgainst": ["Normal LED heat", "Sharp battery rebound"]
    }
  ],
  "diagnosticRules": [
    {
      "id": "rule.indicator.green.controller",
      "hypothesisId": "charge.controller.failure",
      "when": {
        "observationId": "obs.charge.indicator",
        "operator": "equals",
        "value": "steady-green"
      },
      "scoreDelta": -22,
      "evidence": "The charge indicator is steady green.",
      "direction": "against",
      "explanationCode": "CHARGE_INDICATOR_NORMAL"
    },
    {
      "id": "rule.indicator.off.controller",
      "hypothesisId": "charge.controller.failure",
      "when": { "observationId": "obs.charge.indicator", "operator": "equals", "value": "off" },
      "scoreDelta": 34,
      "evidence": "The charge indicator remains off.",
      "direction": "for",
      "explanationCode": "CHARGE_INDICATOR_MISSING"
    },
    {
      "id": "rule.off.nominal.battery",
      "hypothesisId": "battery.high.resistance",
      "when": { "observationId": "obs.voltage.off", "operator": "between", "value": [3.1, 3.45] },
      "scoreDelta": 8,
      "evidence": "The battery accepts a surface charge near its nominal range.",
      "direction": "for",
      "explanationCode": "BATTERY_SURFACE_CHARGE"
    },
    {
      "id": "rule.off.nominal.controller",
      "hypothesisId": "charge.controller.failure",
      "when": { "observationId": "obs.voltage.off", "operator": "between", "value": [3.1, 3.45] },
      "scoreDelta": -8,
      "evidence": "Off-load voltage reaches the expected charged range.",
      "direction": "against",
      "explanationCode": "CHARGE_VOLTAGE_PRESENT"
    },
    {
      "id": "rule.load.collapse.battery",
      "hypothesisId": "battery.high.resistance",
      "when": { "observationId": "obs.voltage.load", "operator": "lt", "value": 2.5 },
      "scoreDelta": 45,
      "evidence": "Battery voltage collapses below 2.50 V under load.",
      "direction": "for",
      "explanationCode": "VOLTAGE_COLLAPSE_UNDER_LOAD"
    },
    {
      "id": "rule.load.stable.battery",
      "hypothesisId": "battery.high.resistance",
      "when": { "observationId": "obs.voltage.load", "operator": "gte", "value": 2.9 },
      "scoreDelta": -35,
      "evidence": "Battery voltage remains stable under load.",
      "direction": "against",
      "explanationCode": "VOLTAGE_STABLE_UNDER_LOAD"
    },
    {
      "id": "rule.rebound.battery",
      "hypothesisId": "battery.high.resistance",
      "when": { "observationId": "obs.voltage.rebound", "operator": "gte", "value": 3 },
      "scoreDelta": 32,
      "evidence": "Voltage rebounds above 3.00 V after switch-off.",
      "direction": "for",
      "explanationCode": "VOLTAGE_REBOUND_AFTER_LOAD"
    },
    {
      "id": "rule.rebound.led",
      "hypothesisId": "led.board.overdraw",
      "when": { "observationId": "obs.voltage.rebound", "operator": "gte", "value": 3 },
      "scoreDelta": -12,
      "evidence": "The sharp rebound points to cell sag rather than a sustained LED fault.",
      "direction": "against",
      "explanationCode": "REBOUND_LOWERS_LED_OVERDRAW"
    },
    {
      "id": "rule.led.hot",
      "hypothesisId": "led.board.overdraw",
      "when": { "observationId": "obs.led.heat", "operator": "equals", "value": "unusually-hot" },
      "scoreDelta": 35,
      "evidence": "The LED board shows unusual heat.",
      "direction": "for",
      "explanationCode": "LED_HEAT_HIGH"
    },
    {
      "id": "rule.led.normal",
      "hypothesisId": "led.board.overdraw",
      "when": { "observationId": "obs.led.heat", "operator": "equals", "value": "normal" },
      "scoreDelta": -18,
      "evidence": "The LED board temperature appears normal.",
      "direction": "against",
      "explanationCode": "LED_HEAT_NORMAL"
    }
  ],
