  "planTemplates": [
    {
      "id": "plan.replace.battery",
      "optionId": "option.replace.battery",
      "title": "Battery module replacement",
      "partIds": ["part.battery.lfp32.jst"],
      "steps": [
        {
          "id": "step.disconnect.power",
          "order": 1,
          "title": "Disconnect charging power",
          "instruction": "Remove the simulated USB-C charging connection.",
          "componentIds": ["usb.port"],
          "safetyRuleIds": ["safety.isolate.power"],
          "humanOnly": true
        },
        {
          "id": "step.switch.off",
          "order": 2,
          "title": "Turn the lamp off",
          "instruction": "Press the main switch so the simulated lamp is off.",
          "componentIds": ["main.switch"],
          "safetyRuleIds": ["safety.isolate.power"],
          "humanOnly": true
        },
        {
          "id": "step.remove.screws",
          "order": 3,
          "title": "Remove the four base screws",
          "instruction": "Rotate the lamp and remove the four screws in a cross pattern.",
          "componentIds": [
            "fastener.base.1",
            "fastener.base.2",
            "fastener.base.3",
            "fastener.base.4"
          ],
          "safetyRuleIds": ["safety.isolate.power"],
          "humanOnly": true
        },
        {
          "id": "step.lift.cover",
          "order": 4,
          "title": "Lift the base cover",
          "instruction": "Lift slowly without pulling the wire harness.",
          "componentIds": ["base.cover", "wire.harness"],
          "safetyRuleIds": ["safety.isolate.power"],
          "humanOnly": true
        },
        {
          "id": "step.inspect.battery",
          "order": 5,
          "title": "Inspect the battery",
          "instruction": "Stop if the simulated cell is swollen, hot, damaged, corroded, or has an unusual odor.",
          "componentIds": ["battery.pack"],
          "safetyRuleIds": ["safety.stop.cell.damage"],
          "humanOnly": true
        },
        {
          "id": "step.disconnect.battery",
          "order": 6,
          "title": "Disconnect the keyed connector",
          "instruction": "Hold the connector body and separate it without pulling the wires.",
          "componentIds": ["battery.pack", "wire.harness"],
          "safetyRuleIds": ["safety.isolate.power"],
          "humanOnly": true
        },
        {
          "id": "step.remove.battery",
          "order": 7,
          "title": "Remove the old battery",
          "instruction": "Lift the demonstration module from its fitted cradle.",
          "componentIds": ["battery.pack"],
          "safetyRuleIds": ["safety.simulation"],
          "humanOnly": true
        },
        {
          "id": "step.seat.replacement",
          "order": 8,
          "title": "Seat the replacement",
          "instruction": "Place the staged module in the cradle with the connector aligned.",
          "componentIds": ["battery.pack"],
          "safetyRuleIds": ["safety.simulation"],
          "humanOnly": true
        },
        {
          "id": "step.reconnect.harness",
          "order": 9,
          "title": "Reconnect the harness",
          "instruction": "Join the keyed connector without forcing it.",
          "componentIds": ["wire.harness", "battery.pack"],
          "safetyRuleIds": ["safety.simulation"],
          "humanOnly": true
        },
        {
